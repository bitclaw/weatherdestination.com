LOADTEST_AUTH_ENABLED=true
LOADTEST_EMAIL=loadtest@example.com
LOADTEST_OTP=loadtest123
LOADTEST_ONBOARDING_EMAIL=onboarding-test@example.com
LOADTEST_ONBOARDING_OTP=onboarding123
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
PLAYWRIGHT_OPEN_REPORT=on-failure
PLAYWRIGHT_SLOW_MO=0
DATABASE_PATH=e2e/data/meta_e2e.db
USER_DATA_DIR=e2e/data/users
ADMIN_EMAILS=loadtest@example.com

# Fake Google OAuth App creds - only needed to flip config.auth.socialProviders.google
# to true so the login page renders the Continue with Google button.
# e2e/tests/auth/social-login-buttons.spec.ts intercepts the sign-in/social
# request before it ever reaches Google, so these values never need to be real.
GOOGLE_CLIENT_ID=e2e-fake-google-client-id
GOOGLE_CLIENT_SECRET=e2e-fake-google-client-secret
VITE_GOOGLE_CLIENT_ID=e2e-fake-google-client-id
