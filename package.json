{
  "name": "warpkit",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "bun --bun vite build && bun scripts/inline-critical-css.ts",
    "start": "bun server/start.ts",
    "start:cluster": "bun cluster.ts",
    "generate": "bunx tsr generate",
    "typecheck": "bun run generate && tsc --noEmit",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "db:generate": "bunx drizzle-kit generate",
    "db:studio": "bunx drizzle-kit studio",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "weather:update-cache": "bun scripts/update-noaa-cache.ts",
    "test": "bun --no-env-file --env-file=.env.test test src/ server/",
    "test:watch": "bun --no-env-file --env-file=.env.test test --watch src/ server/",
    "test:load": "bun tests/load-test.ts",
    "test:load:quick": "bun tests/load-test.ts --quick",
    "test:load:public": "bun tests/load-test.ts --public-only",
    "test:load:admin": "bun tests/load-test-admin.ts",
    "test:load:admin:quick": "bun tests/load-test-admin.ts --quick",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --headed --project=chromium --workers=3",
    "test:e2e:webkit": "playwright test --headed --project=webkit --workers=3",
    "test:e2e:report": "playwright show-report e2e/.tmp/playwright-report",
    "clean": "rm -rf node_modules/.vite .vinxi .nitro .output",
    "knip": "bunx knip",
    "theme": "bunx --bun shadcn@latest apply --only theme -y",
    "generate:favicons": "bun scripts/generate-favicons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1063.0",
    "@aws-sdk/s3-presigned-post": "3.1063.0",
    "@aws-sdk/s3-request-presigner": "3.1063.0",
    "@better-auth/utils": "0.4.2",
