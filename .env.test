# Test environment overrides
# Auto-loaded by Bun when NODE_ENV=test (set in bunfig.toml).
# Overrides values from .env for test runs , no package.json changes needed.

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_test_fake_key
BETTER_AUTH_SECRET=ci-test-secret-not-used-in-production-placeholder
INDEXNOW_KEY=indexnow-test-key-not-used-in-production-placeholder
USER_DATA_DIR=data/users
JOBS_DB_PATH=:memory:
# boot-smoke.ts spawns server/start.ts with NODE_ENV=production against this
# file - src/start.ts's production-only boot checks are real at that point
# (no longer skipped, since TSS_PRERENDERING is only set during the vite
# build's own prerender crawl, not at server boot), so these two need a
# placeholder the same way STRIPE_WEBHOOK_SECRET/RESEND_API_KEY already do.
STRIPE_SECRET_KEY=sk_test_fake_key_not_used_in_production
ADMIN_EMAILS=admin@example.com
# Fake secret so signature-validation tests can exercise real Stripe
# signature checking (not just the config-error path). The
# "missing secret" test unsets this var itself for that one case.
STRIPE_WEBHOOK_SECRET=whsec_test_fake_secret_not_used_in_production

# Git provider OAuth (fake values for tests)
GITHUB_CLIENT_ID=fake_github_id
GITHUB_CLIENT_SECRET=fake_github_secret
GITLAB_CLIENT_ID=fake_gitlab_id
GITLAB_CLIENT_SECRET=fake_gitlab_secret
BITBUCKET_CLIENT_ID=fake_bitbucket_id
BITBUCKET_CLIENT_SECRET=fake_bitbucket_secret
