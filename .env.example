# Test environment overrides go in .env.test , auto-loaded by Bun when NODE_ENV=test (bunfig.toml)

# Logging (optional: default "info"; set "debug" to enable SQL query logging)
# LOG_LEVEL=debug

# Database
DATABASE_PATH=data/meta.db
# RUNMIST_DATA_DIR is set automatically by Runmist when deploying through
# the platform and takes priority over USER_DATA_DIR when present - leave
# USER_DATA_DIR as-is (or unset) when self-hosting.
USER_DATA_DIR=data/users

# Background jobs (optional: defaults to data/jobs.db)
# JOBS_DB_PATH=data/jobs.db

# Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-here-generate-with-openssl-rand-hex-32

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price IDs , set vars for the plans defined in config.ts (VITE_ prefix required for client bundle)
# See docs/features/billing.md for how to add or remove tiers.

# 1-tier (Pro only) , uncomment and fill in
# VITE_STRIPE_PRO_PRICE_ID=price_...
# VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_...

# 2-tier (Solo + Pro) , uncomment and fill in
# VITE_STRIPE_SOLO_PRICE_ID=price_...
# VITE_STRIPE_SOLO_YEARLY_PRICE_ID=price_...
# VITE_STRIPE_PRO_PRICE_ID=price_...
# VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_...

# 3-tier (Solo + Pro + Team) , default config
VITE_STRIPE_SOLO_PRICE_ID=price_...
VITE_STRIPE_SOLO_YEARLY_PRICE_ID=price_...
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_...
VITE_STRIPE_TEAM_PRICE_ID=price_...
VITE_STRIPE_TEAM_YEARLY_PRICE_ID=price_...

# One-time purchase (set VITE_BILLING_MODE=one_time and add oneTime block to plan in config.ts)
# VITE_STRIPE_ONE_TIME_PRICE_ID=price_...

# Credits system: set to "false" to disable (optional: defaults to enabled)
# VITE_CREDITS_ENABLED=true

# Credits top-up (required when credits.enabled = true in config.ts)
# VITE_STRIPE_CREDITS_PRICE_ID=price_...

# Billing mode (optional: default "subscription"; options: subscription | one_time)
# VITE_BILLING_MODE=subscription

# Free trial , subscription mode only; omit to disable
# VITE_TRIAL_DAYS=14
# Set to "true" to allow sign-up without a card during trial (default: card required)
# VITE_TRIAL_NO_CARD=true

# Email (Resend)
RESEND_API_KEY=re_...

# Optional: SMTP instead of Resend
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_SECURE=true   # set to "true" for port 465 (SSL); omit or "false" for STARTTLS

# Local email testing with Mailpit (make mail.up → http://localhost:8025)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025

# AI chat (OpenRouter) , required for /chat cloud mode; get key at openrouter.ai
# OPENROUTER_API_KEY=sk-or-...

# Admin panel: comma-separated emails that can access /admin
# ADMIN_EMAILS=you@example.com,colleague@example.com

# IP rate limiter: which header to trust for client IP (default: none)
# cloudflare = cf-connecting-ip
# nginx       = x-real-ip (nginx with proxy_set_header X-Real-IP $remote_addr)
# proxy       = x-forwarded-for[0] (Caddy, haproxy, any sanitizing reverse proxy)
# none        = no header trust (direct internet) - every caller falls into
#               one shared rate-limit bucket unless failClosedOnUnknownIp is
#               set on that limiter (see src/server/rate-limit.ts), in which
#               case requests with no resolvable IP are blocked outright.
#
# Set this to match your actual deployment topology - the default (none) is
# deliberately NOT cloudflare, since most of this template's own deployment
# recipes (Docker, Fly.io, Railway) don't put Cloudflare in front, and
# trusting cf-connecting-ip when nothing is actually stripping/verifying it
# lets any caller set an arbitrary value and get a fresh rate-limit bucket
# per request.
#
# WARNING: none of these headers are spoof-proof unless your origin server
# actually rejects direct traffic that skips the proxy. If you deploy behind
# Cloudflare, firewall the origin to only accept connections from Cloudflare's
# published IP ranges (https://www.cloudflare.com/ips/) before setting this
# to cloudflare - otherwise anyone can hit your origin directly with a forged
# cf-connecting-ip header and bypass every IP-keyed rate limiter in this app
# (lead capture, signup, checkout, account deletion, admin actions). Same
# applies to nginx/proxy: only trust the header if your own reverse proxy is
# the sole path to the app.
# TRUST_PROXY=none

# Auth verification method (optional: default "otp"; options: otp | magic-link | both)
# VITE_AUTH_VERIFICATION_METHOD=otp

# Email validation (optional: disposable check on by default; MX check off by default)
# VITE_DISPOSABLE_EMAIL_CHECK=false
# VITE_MX_CHECK=true

# Cloudflare Turnstile captcha (optional: omit to disable; both keys required)
# TURNSTILE_SECRET_KEY=0x...
# VITE_TURNSTILE_SITE_KEY=0x...

# Google OAuth (optional: omit to disable Google sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VITE_GOOGLE_CLIENT_ID=    # same value as GOOGLE_CLIENT_ID , exposes the button in the login UI

# GitHub OAuth (optional: omit to disable GitHub sign-in)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# VITE_GITHUB_CLIENT_ID=    # same value as GITHUB_CLIENT_ID , exposes the button in the login UI

# GitLab OAuth (optional: omit to disable GitLab sign-in)
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# VITE_GITLAB_CLIENT_ID=    # same value as GITLAB_CLIENT_ID. NOTE: server-side auth only , the login page has no GitLab button; add one to src/pages/login if needed

# Bitbucket OAuth (optional: omit to disable; uses Bitbucket OAuth consumers, not Atlassian)
# Create at https://bitbucket.org/account/settings/app-passwords (OAuth consumers)
# Callback URL: https://yourdomain.com/api/auth/callback/bitbucket
# BITBUCKET_CLIENT_ID=
# BITBUCKET_CLIENT_SECRET=
# VITE_BITBUCKET_CLIENT_ID=  # same value. NOTE: server-side auth only , the login page has no Bitbucket button; add one to src/pages/login if needed


# File uploads , S3 (optional: omit to disable)
# AWS_S3_IAM_ACCESS_KEY=
# AWS_S3_IAM_SECRET_KEY=
# AWS_S3_FILES_BUCKET=
# AWS_S3_REGION=us-east-1
# VITE_S3_FILES_BUCKET=    # same value as AWS_S3_FILES_BUCKET , enables upload UI

# Umami analytics (optional: omit to disable)
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js

# Microsoft Clarity — session recordings + heatmaps (optional: omit to disable)
# Get your Project ID from https://clarity.microsoft.com/
# VITE_CLARITY_PROJECT_ID=

# Crisp live chat (optional: omit to disable)
# VITE_CRISP_WEBSITE_ID=

# Load test (optional: enables /api/loadtest/auth for test tooling)
# LOADTEST_AUTH_ENABLED=true
# LOADTEST_EMAIL=loadtest@example.com
# LOADTEST_OTP=loadtest123


# Sentry error tracking (optional: omit to disable; VITE_ prefix exposes DSN to browser bundle)
# DSNs are public by design , safe to commit or expose client-side
# VITE_SENTRY_DSN=https://...@...ingest.sentry.io/...

# IndexNow: notifies Bing/Yandex/etc. of page changes instead of waiting on
# organic recrawl. Auto-generated by `make init` , not secret (the protocol
# requires it to be publicly served at /{key}.txt), needs no external
# account. See docs/warpkit/features/indexnow.md. Run `make indexnow.submit`
# to notify search engines of every URL in your sitemap.
INDEXNOW_KEY=

# Feature flags (defined in src/lib/feature-flags.ts)
# Stable features default ON: set to "false" to disable
FEATURE_BLOG=false
# FEATURE_LEADS=false

# Per-user encrypted settings: 64-char hex (32 bytes) for AES-256-GCM.
# Required only if you use setEncryptedSetting (see docs/patterns/per-user-settings.md).
# Generate: openssl rand -hex 32   , validated at startup in src/start.ts
# SETTINGS_ENCRYPTION_KEY=

# NOAA Climate Data Online API token, required by `bun run weather:update-cache`.
# Get one at https://www.ncdc.noaa.gov/cdo-web/token
# NOAA_API_TOKEN=
